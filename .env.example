# Copy to .env (git-ignored) and fill in. Nothing here is bought from anyone.
#
# CRAWL4AI_API_TOKEN is a shared secret between the two local containers:
# the core service sends it as "Authorization: Bearer ...", the browser
# container checks it. Make up any long random string, for example:
#   python -c "import secrets; print(secrets.token_hex(24))"
CRAWL4AI_API_TOKEN=
